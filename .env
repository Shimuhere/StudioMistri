# StudioMistri Backend Environment Configuration
SECRET_KEY=django-insecure-studio-mistri-3d-print-neobrutalism-2026-secret-key-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@localhost:5432/database_name
# If DB_NAME is set, it will use PostgreSQL with the parameters below.
# If no Postgres server is running, it gracefully falls back to SQLite so development is frictionless.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=studiomistri_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Or specify a direct DATABASE_URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/studiomistri_db

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
